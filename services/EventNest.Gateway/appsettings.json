{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.ReverseProxy": "Information"
    }
  },
  "HealthChecks": {
    "AuthService": "http://localhost:5001/health",
    "EventService": "http://localhost:5002/health",
    "TagService": "http://localhost:5003/health",
    "RSVPService": "http://localhost:5004/health"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_HERE_MIN_32_CHARS_LONG!!",
    "Issuer": "EventNest.AuthService",
    "Audience": "EventNest"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/auth/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "auth-user-route": {
        "ClusterId": "auth-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/users/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "AuthorizationPolicy": "authenticated"
      },
      "event-route": {
        "ClusterId": "event-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/events/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "tag-route": {
        "ClusterId": "tag-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/tags/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "rsvp-route": {
        "ClusterId": "rsvp-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/events/{eventId}/rsvps/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        },
        "AuthorizationPolicy": "authenticated"
      },
      "rsvp-user-route": {
        "ClusterId": "rsvp-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/users/{userId}/rsvps/{**catch-all}",
          "Methods": ["GET"]
        },
        "AuthorizationPolicy": "authenticated"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-1": { "Address": "http://localhost:5001/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "event-cluster": {
        "Destinations": {
          "event-1": { "Address": "http://localhost:5002/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "tag-cluster": {
        "Destinations": {
          "tag-1": { "Address": "http://localhost:5003/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "rsvp-cluster": {
        "Destinations": {
          "rsvp-1": { "Address": "http://localhost:5004/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      }
    }
  }
}
