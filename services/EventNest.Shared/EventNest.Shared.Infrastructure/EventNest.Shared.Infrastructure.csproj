<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\auth.proto" GrpcServices="Both" />
    <Protobuf Include="Proto\tag.proto" GrpcServices="Both" />
    <Protobuf Include="Proto\event.proto" GrpcServices="Both" />
    <Protobuf Include="Proto\rsvp.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
